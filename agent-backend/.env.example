ES_URL=http://elasticsearch:9200
ES_INDEX=devops-logs-*

# Primary model
LLM_MODEL=gemma-4-31b-it

# Fallback chain — tried in order when all keys for the primary are rate-limited.
# LLM_MODEL_FALLBACK=gemini-2.0-flash,gpt-4o-mini,claude-haiku-4-5-20251001

# Generic fallback key used when no provider-specific key is set.
LLM_API_KEY=your-fallback-key-here

# Per-provider API keys — comma-separated for key rotation on rate-limit.
# The system tries key1, key2, ... before moving to the next model in the fallback chain.
GOOGLE_API_KEYS=your-google-key-1,your-google-key-2     # gemini-* and gemma-* models
ANTHROPIC_API_KEYS=your-anthropic-key-1                  # claude-* models
OPENAI_API_KEYS=your-openai-key-1,your-openai-key-2      # gpt-*, o1-*, o3-*, o4-* models

ENVIRONMENT=dev
