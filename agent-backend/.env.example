ES_URL=http://elasticsearch:9200
ES_INDEX=devops-logs-*

# Primary model
LLM_MODEL=gemma-4-31b-it

# Fallback chain — tried in order on rate-limit / quota errors
# LLM_MODEL_FALLBACK=gemini-2.0-flash,claude-haiku-4-5-20251001

# API keys — set the key for each provider you use.
# LLM_API_KEY is the generic fallback when a provider-specific key is absent.
LLM_API_KEY=your-fallback-key-here
GOOGLE_API_KEY=your-google-ai-key-here       # gemini-* and gemma-* models
ANTHROPIC_API_KEY=your-anthropic-key-here    # claude-* models

ENVIRONMENT=dev
